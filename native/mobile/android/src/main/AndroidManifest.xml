<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" /></intent>
        <package android:name="com.google.android.gms" />
    </queries>
    <application>
        <service android:name="org.lectorlibre.mobile.ReaderSpeechService"
            android:exported="false" android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />
    </application>
</manifest>
